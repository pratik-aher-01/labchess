{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('metadata/status').val() === 'waiting' || (data.child('players/white/uid').val() === auth.uid || data.child('players/black/uid').val() === auth.uid))",
        "metadata": {
          ".validate": "newData.hasChildren(['status', 'createdAt'])",
          "hostUid": {
            ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val())"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'active' || newData.val() === 'finished' || newData.val() === 'expired')"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "expiresAt": {
            ".validate": "newData.isNumber()"
          },
          "rematchRequestedBy": {
            // Must be null (clear) or the authenticated user's own UID (can't impersonate)
            ".validate": "newData.val() === null || (newData.isString() && newData.val() === auth.uid)"
          },
          "drawOfferedBy": {
            // Must be null (decline/clear) or the authenticated user's own UID (can't spoof offers)
            ".validate": "newData.val() === null || (newData.isString() && newData.val() === auth.uid)"
          },
          "timeControl": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          "white": {
            ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid', 'name'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "connected": {
              ".validate": "newData.isBoolean()"
            },
            "lastSeen": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "black": {
            ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid', 'name'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "connected": {
              ".validate": "newData.isBoolean()"
            },
            "lastSeen": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "spectators": {
          ".write": "auth != null",
          "$spectatorUid": {
            ".validate": "auth.uid === $spectatorUid && newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "chat": {
          ".write": "auth != null",
          "$msgId": {
            // Rate-limit: timestamp must be within 5 seconds of server time
            ".validate": "newData.hasChildren(['sender', 'text', 'timestamp']) && newData.child('timestamp').val() >= (now - 5000) && newData.child('timestamp').val() <= (now + 5000)",
            "senderUid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "sender": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
            },
            "timestamp": {
              ".validate": "newData.isNumber() && newData.val() >= (now - 5000) && newData.val() <= (now + 5000)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "reactions": {
          ".write": "auth != null",
          "$rxId": {
            // Rate-limit: timestamp must be within 5 seconds of server time
            ".validate": "newData.hasChildren(['emoji', 'timestamp']) && newData.child('timestamp').val() >= (now - 5000) && newData.child('timestamp').val() <= (now + 5000)",
            "senderUid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "emoji": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "timestamp": {
              ".validate": "newData.isNumber() && newData.val() >= (now - 5000) && newData.val() <= (now + 5000)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "game": {
          ".write": "auth != null && (data.parent().child('players/white/uid').val() === auth.uid || data.parent().child('players/black/uid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['fen', 'turn', 'status'])",
          "fen": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "turn": {
            ".validate": "newData.isString() && (newData.val() === 'w' || newData.val() === 'b')"
          },
          "moveNumber": {
            ".validate": "newData.isNumber()"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'in_progress' || newData.val() === 'checkmate' || newData.val() === 'stalemate' || newData.val() === 'draw' || newData.val() === 'resigned' || newData.val() === 'timeout')"
          },
          "winner": {
            ".validate": "newData.val() === null || newData.val() === 'w' || newData.val() === 'b' || newData.val() === 'draw'"
          },
          "lastMove": {
            ".validate": "newData.val() === null || (newData.hasChildren(['from', 'to', 'san']) && newData.child('from').isString() && newData.child('to').isString() && newData.child('san').isString())"
          },
          "clocks": {
            ".validate": "newData.val() === null || newData.hasChildren(['whiteTimeMs', 'blackTimeMs'])"
          },
          "$other": {
            ".validate": false
          }
        },
        "moves": {
          ".write": "auth != null && (data.parent().child('players/white/uid').val() === auth.uid || data.parent().child('players/black/uid').val() === auth.uid)",
          "$moveIndex": {
            ".validate": "newData.hasChildren(['playerUid', 'from', 'to', 'san', 'timestamp']) && newData.child('playerUid').val() === auth.uid"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
