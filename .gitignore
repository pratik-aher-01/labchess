# ─────────────────────────────────────────────
#  LabChess — .gitignore (Production & Security Hardened)
# ─────────────────────────────────────────────

# OS metadata & temporary files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor & IDE configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# Dependencies & Package Managers
node_modules/
functions/node_modules/
.pnp
.pnp.js

# Build artifacts & caches
.vercel/
.firebase/
functions/.runtimecache/

# Debug & Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# Environment & Secret files
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.pfx
*.p12
*serviceAccount*.json
*credentials*.json
private-key*.json

# Firebase local config with active credentials
# (See config.example.js for the safe template)
config.js